{
  "name": "vite_react_shadcn_ts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "dev": "vite",
    "docker:build": "docker build -t swift-gallery:latest .",
    "docker:up": "docker-compose up",
    "docker:down": "docker-compose down",
    "docker:clean": "docker-compose down -v && docker system prune -f",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky install || true",
    "preview": "vite preview",
    "sort-package-json": "sort-package-json",
    "test": "jest",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "test:unit": "jest --testPathPattern='__tests__/'",
    "test:integration": "jest --testPathPattern='__tests__/pages/'",
    "test:cypress": "cypress run --spec 'cypress/e2e/*.cy.ts'",
    "test:cypress:a11y": "cypress run --spec 'cypress/e2e/a11y-cyber.cy.ts'",
    "test:cypress:open": "cypress open",
    "test:cypress:open:a11y": "cypress open --spec 'cypress/e2e/a11y-cyber.cy.ts'",
    "storybook": "npx storybook dev -p 6006",
    "build-storybook": "npx storybook build",
    "typecheck": "tsc --noEmit"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,scss}": [
      "prettier --write"
    ],
    "package.json": [
      "npm run sort-package-json"
    ]
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@radix-ui/react-accordion": "^1.2.0",
    "@radix-ui/react-alert-dialog": "^1.1.1",
    "@radix-ui/react-aspect-ratio": "^1.1.1",
